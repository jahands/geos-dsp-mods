{
	"$schema": "https://turbo.build/schema.json",
	"globalPassThroughEnv": ["DOTNET_ROOT", "FORCE_COLOR"],
	"tasks": {
		"topo": {
			"dependsOn": ["^topo"]
		},
		"build": {
			"dependsOn": ["^build", "topo"],
			"outputs": ["bin/**", "obj/**", "dist/**"],
			"outputLogs": "new-only"
		},
		"check:types": {
			"dependsOn": ["topo"],
			"outputLogs": "new-only"
		},
		"test": {
			"dependsOn": ["topo"],
			"outputLogs": "new-only"
		}
	}
}
